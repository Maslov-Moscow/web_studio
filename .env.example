# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-in-production

# PostgreSQL Settings
POSTGRES_DB=webstudio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Frontend Settings
# Set to 'true' to use mock API data (for development/testing without backend)
# ⚠️ IMPORTANT: Must be lowercase 'true', NOT 'True' or 'TRUE'
# When enabled, you'll see [MOCK] messages in browser console
NEXT_PUBLIC_USE_MOCK_API=false

# API URL - defaults to '/api' if not set
# In production, this should point to your backend API
NEXT_PUBLIC_API_URL=/api
